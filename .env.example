# ==========================================
# FinPay Environment Configuration
# ==========================================

# Database Configuration
# Default: Simple SQLite database (zero configuration)
DATABASE_URL=sqlite:///./finpay.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://finpay:finpay@localhost:5432/finpay

# JWT Authentication
JWT_SECRET_KEY=finpay-secure-jwt-secret-key-student-wallet-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST=127.0.0.1
PORT=8000

# ==========================================
# Unresolved Business Policies (Handled Safely)
# ==========================================

# Q3. Negative Wallet Balance:
# Set to 'true' to enforce wallet.balance >= payment amount
# Set to 'false' if student wallets are permitted to overdraft
ENFORCE_NON_NEGATIVE_BALANCE=true

# Q1. Cashback Policy:
# Kept 'false' until official eligibility criteria and amounts are confirmed
CASHBACK_ENABLED=false
